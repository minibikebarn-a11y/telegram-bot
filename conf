def _sanitize_image_name(name):
    import re, unicodedata
    name = unicodedata.normalize("NFKD", name)
    name = name.encode("ascii", "ignore").decode("ascii")
    name = re.sub(r"[^a-zA-Z0-9]+", "_", name).strip("_").lower()
    return name + ".jpg"

def get_product_image(product_name):
    """Return (cached_file_id_or_None, local_path_or_None) for a product image."""
    if product_name in _PRODUCT_IMAGE_CACHE:
        return _PRODUCT_IMAGE_CACHE[product_name], None
    filename = _sanitize_image_name(product_name)
    path = _os.path.join(IMAGES_DIR, filename)
    if _os.path.exists(path):
        return None, path
    return None, None
