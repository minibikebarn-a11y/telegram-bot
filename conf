@bot.message_handler(content_types=["photo"],
                     func=lambda m: m.chat.id in ADMIN_IDS)
def handle_admin_photo(message):
    file_id = message.photo[-1].file_id
    # Save to config.py so it persists across restarts
    config_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "config.py")
    try:
        with open(config_path, "r", encoding="utf-8") as f:
            content = f.read()
        if "MENU_IMAGE_ID" in content:
            import re
            content = re.sub(r'MENU_IMAGE_ID\s*=\s*"[^"]*"', f'MENU_IMAGE_ID = "{file_id}"', content)
        else:
            content += f'\nMENU_IMAGE_ID = "{file_id}"\n'
        with open(config_path, "w", encoding="utf-8") as f:
            f.write(content)
        global MAIN_MENU_IMAGE_ID
        MAIN_MENU_IMAGE_ID = file_id
        bot.reply_to(message, f"✅ Menu image updated!\n<code>{file_id}</code>", parse_mode="HTML")
    except Exception as e:
        bot.reply_to(message, f"❌ Failed to save: {e}")

