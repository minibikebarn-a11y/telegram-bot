# ── Callback dispatcher ────────────────────────────────────────────────────────

@bot.callback_query_handler(func=lambda _: True)
def handle_callback(call):
    chat_id = call.message.chat.id
    mid = call.message.message_id
    data = call.data

    bot.answer_callback_query(call.id)

    # ── Passphrase flow ──────────────────────────────────────────────────────

    if data == "about_secret_phrase":
        text, kb = passphrase_about_content()
        show_text_screen(chat_id, text, kb)

    elif data == "passphrase_about_understood":
        text, kb = passphrase_intro_content()
        show_text_screen(chat_id, text, kb)

    elif data == "set_secret_phrase":
        text, kb = passphrase_entry_content()
        show_text_screen(chat_id, text, kb)
        waiting_for_phrase.add(chat_id)
        first_time_setup.add(chat_id)

    elif data == "phrase_verified":
        if chat_id in first_time_setup:
            first_time_setup.discard(chat_id)
            text, kb = safety_warning_content()
            _send_photo_or_text(chat_id, text, kb)
        else:
            show_main_menu(chat_id)

    elif data == "phrase_denied":
        text, kb = passphrase_entry_content()
        show_text_screen(chat_id, text, kb)
        waiting_for_phrase.add(chat_id)

    elif data == "safety_agreed":
        show_main_menu(chat_id)

    elif data == "group_chats_understood":
        show_main_menu(chat_id)

    # ── Main menu ────────────────────────────────────────────────────────────

    elif data == "listings":
        text, kb = listings_content(chat_id)
        _send_photo_or_text(chat_id, text, kb)

    elif data.startswith("cat_"):
        cat_name = data[4:]
        text, kb = category_content(cat_name, chat_id)
        _edit_caption_or_new(chat_id, mid, text, kb)

    elif data.startswith("subcat_"):
        parts = data[7:].split("|", 1)
        cat_name, subcat_name = parts[0], parts[1]
        text, kb = subcategory_content(cat_name, subcat_name, chat_id)
        _edit_caption_or_new(chat_id, mid, text, kb)

    elif data.startswith("prodi_"):
        parts = data[6:].split("|", 2)
        if len(parts) == 3:
            cat_n, sub_n, idx_s = parts
            try:
                product_name = PRODUCTS[cat_n][sub_n][int(idx_s)][0]
                _step = PRODUCT_DETAILS.get(product_name, {}).get("step", 1.0)
                user_product_state[chat_id] = {"product": product_name, "qty": _step}
                text, kb = product_content(product_name, chat_id)
                _fid, _path = get_product_image(product_name)
                show_photo_screen(chat_id, text, kb,
                                  photo_id=_fid, photo_path=_path, cache_key=product_name)
            except (KeyError, IndexError, ValueError):
                pass

    elif data.startswith("prod_"):
        parts = data[5:].split("|", 2)
        if len(parts) == 3:
            _, __, product_name = parts
            _step = PRODUCT_DETAILS.get(product_name, {}).get("step", 1.0)
            user_product_state[chat_id] = {"product": product_name, "qty": _step}
            text, kb = product_content(product_name, chat_id)
            _fid, _path = get_product_image(product_name)
            show_photo_screen(chat_id, text, kb,
                              photo_id=_fid, photo_path=_path, cache_key=product_name)

    elif data in ("qty_plus", "qty_minus", "qty_manual", "add_to_cart", "add_wishlist",
                  "prod_reviews", "cart_view"):
        state = user_product_state.get(chat_id, {})
        product_name = state.get("product")

        if data == "qty_plus" and product_name:
            step = PRODUCT_DETAILS.get(product_name, {}).get("step", 1.0)
            state["qty"] = state.get("qty", step) + step
            user_product_state[chat_id] = state
            text, kb = product_content(product_name, chat_id)
            update_text_screen(chat_id, text, kb)

        elif data == "qty_minus" and product_name:
            step = PRODUCT_DETAILS.get(product_name, {}).get("step", 1.0)
            state["qty"] = max(step, state.get("qty", step) - step)
            user_product_state[chat_id] = state
            text, kb = product_content(product_name, chat_id)
            update_text_screen(chat_id, text, kb)

        elif data == "qty_manual":
            waiting_for_qty.add(chat_id)
            bot.send_message(chat_id, "✏️ Enter the quantity (e.g. 5 or 10):")

