# ── Unified screen management ──────────────────────────────────────────────────
# One active message per user. Every new screen deletes the old one first.

user_active_msg = {}   # chat_id → message_id of the current bot message

def _delete_active(chat_id):
    mid = user_active_msg.pop(chat_id, None)
    if mid:
        try:
            bot.delete_message(chat_id, mid)
        except Exception:
            pass

def _track(chat_id, msg):
    if msg:
        user_active_msg[chat_id] = msg.message_id

def show_photo_screen(chat_id, text, kb, photo_id=None, photo_path=None, cache_key=None):
    """Delete previous message, send photo (or text fallback), track new message."""
    _delete_active(chat_id)
    # Send from local file, cache the returned file_id for future calls
    if photo_path and _os.path.exists(photo_path):
        try:
            with open(photo_path, "rb") as f:
                msg = bot.send_photo(chat_id, f, caption=text, parse_mode="HTML", reply_markup=kb)
            _track(chat_id, msg)
            if cache_key:
                _PRODUCT_IMAGE_CACHE[cache_key] = msg.photo[-1].file_id
            return
        except Exception as e:
            logging.error(f"send_photo (file) failed: {e}")
    # Use cached file_id or fallback menu image
    img = photo_id or MAIN_MENU_IMAGE_ID
    if img:
        try:
            _track(chat_id, bot.send_photo(chat_id, photo=img,
                                           caption=text, parse_mode="HTML", reply_markup=kb))
            return
        except Exception as e:
            logging.error(f"send_photo failed: {e}")
    _track(chat_id, bot.send_message(chat_id, text, parse_mode="HTML",
                                     reply_markup=kb, disable_web_page_preview=True))

def show_text_screen(chat_id, text, kb):
    """Delete previous message, send text message, track new message."""
    _delete_active(chat_id)
    _track(chat_id, bot.send_message(chat_id, text, parse_mode="HTML",
                                     reply_markup=kb, disable_web_page_preview=True))

def update_text_screen(chat_id, text, kb):
    """Edit current tracked message in place (used for qty +/- on product page).
    Tries caption edit first (photo messages), then text edit, then sends new."""
    mid = user_active_msg.get(chat_id)
    if mid:
        try:
            bot.edit_message_caption(chat_id=chat_id, message_id=mid, caption=text,
                                     parse_mode="HTML", reply_markup=kb)
            return
        except Exception:
            pass
        try:
            bot.edit_message_text(chat_id=chat_id, message_id=mid, text=text,
                                  parse_mode="HTML", reply_markup=kb,
                                  disable_web_page_preview=True)
            return
        except Exception:
            pass
    show_text_screen(chat_id, text, kb)

