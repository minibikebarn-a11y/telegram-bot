@bot.message_handler(func=lambda m: m.chat.id in waiting_for_qty and m.content_type == "text")
def handle_qty_input(message):
    chat_id = message.chat.id
    waiting_for_qty.discard(chat_id)
    try:
        qty = float(message.text.strip().replace(",", "."))
        if qty <= 0:
            raise ValueError
    except ValueError:
        bot.send_message(chat_id, "⚠️ Invalid quantity. Please enter a positive number.")
        return
    state = user_product_state.get(chat_id, {})
    product_name = state.get("product")
    if not product_name:
        return
    state["qty"] = qty
    user_product_state[chat_id] = state
    text, kb = product_content(product_name, chat_id)
    update_text_screen(chat_id, text, kb)

@bot.message_handler(func=lambda m: m.chat.id in waiting_for_discount and m.content_type == "text")
def handle_discount_input(message):
    chat_id = message.chat.id
    waiting_for_discount.discard(chat_id)
    code = message.text.strip()
    matched = code if code in PRESET_DISCOUNT_CODES else (code.upper() if code.upper() in PRESET_DISCOUNT_CODES else None)
    if matched:
        pct = PRESET_DISCOUNT_CODES[matched]
        user_discount[chat_id] = pct
        user_discount_code[chat_id] = matched
        bot.send_message(chat_id, f"✅ Discount code applied: {pct:.1f}% off")
    else:
        bot.send_message(chat_id, "❌ Invalid discount code.")
    text, kb = checkout_content(chat_id)
    show_text_screen(chat_id, text, kb)

@bot.message_handler(func=lambda m: m.chat.id in waiting_for_address and m.content_type == "text")
def handle_address_input(message):
    chat_id = message.chat.id
    waiting_for_address.discard(chat_id)
    address = message.text.strip()
    if len(address) < 5:
        bot.send_message(chat_id, "⚠️ Address too short. Please try again.")
        waiting_for_address.add(chat_id)
        return
    user_address[chat_id] = address
    kb2 = types.InlineKeyboardMarkup()
    kb2.row(
        types.InlineKeyboardButton("Check Delivery Address",  callback_data="check_address"),
        types.InlineKeyboardButton("Remove Delivery Address", callback_data="remove_address"),
    )
    kb2.add(types.InlineKeyboardButton("Continue checkout", callback_data="checkout"))
    show_text_screen(chat_id,
        "🎉 Your address has been encrypted using the seller's public key and saved. "
        "The address will be revealed to the seller after the order is paid for.", kb2)

@bot.message_handler(func=lambda m: m.chat.id in waiting_for_phrase and m.content_type == "text")
def handle_phrase_input(message):
    chat_id = message.chat.id
