REVIEWS_PER_PAGE = 10

def get_reviews_page(page_number=1, filter_stars=None, filter_product=None):
    """Get REVIEWS_PER_PAGE reviews for a specific page with optional star/product filters."""
    try:
        conn = get_db_connection()
        cursor = _get_cursor(conn)
        conditions = []
        params = []
        if filter_stars is not None:
            conditions.append("rating = ?")
            params.append(filter_stars)
        if filter_product:
            conditions.append("product LIKE ?")
            params.append(f"%{filter_product}%")
        where = ("WHERE " + " AND ".join(conditions)) if conditions else ""
        cursor.execute(f"SELECT COUNT(*) FROM reviews {where}", params)
        total = cursor.fetchone()[0]
        offset = (page_number - 1) * REVIEWS_PER_PAGE
        cursor.execute(
            f"SELECT rating, amount, product, review_text, date_time FROM reviews {where} ORDER BY added_at DESC LIMIT {REVIEWS_PER_PAGE} OFFSET ?",
            params + [offset]
        )
        reviews = cursor.fetchall()
        cursor.close()
        conn.close()
        return reviews, total
    except Exception as e:
        logging.error(f"Error getting reviews: {e}")
        return [], 0


def get_star_counts(filter_product=None):
    """Return dict {star: count} for reviews, optionally filtered by product."""
    try:
        conn = get_db_connection()
        cursor = _get_cursor(conn)
        if filter_product:
            cursor.execute(
                "SELECT rating, COUNT(*) FROM reviews WHERE product LIKE ? GROUP BY rating",
                (f"%{filter_product}%",)
            )
        else:
            cursor.execute("SELECT rating, COUNT(*) FROM reviews GROUP BY rating")
        rows = cursor.fetchall()
        cursor.close()
        conn.close()
        return {r: c for r, c in rows}
    except Exception as e:
        logging.error(f"Error getting star counts: {e}")
        return {}


def seed_reviews_db():
    """Seed REVIEWS_DATA into the DB only if the table is empty."""
    try:
        conn = get_db_connection()
        cursor = _get_cursor(conn)
        cursor.execute("SELECT COUNT(*) FROM reviews")
        count = cursor.fetchone()[0]
        if count == 0:
            for i, (rating, amount, product, review_text, date_time) in enumerate(REVIEWS_DATA):
                cursor.execute(
                    "INSERT INTO reviews (rating, amount, product, review_text, date_time, page_number, added_at) VALUES (?, ?, ?, ?, ?, ?, ?)",
                    (rating, amount, product, review_text, date_time, (i // REVIEWS_PER_PAGE) + 1, float(i))
                )
            conn.commit()
            logging.info(f"✅ Seeded {len(REVIEWS_DATA)} reviews into DB")
        cursor.close()
        conn.close()
    except Exception as e:
        logging.error(f"Error seeding reviews: {e}")

