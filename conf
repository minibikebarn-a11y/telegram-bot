def product_content(product_name, chat_id=None):
    d = PRODUCT_DETAILS.get(product_name, {})
    qty  = user_product_state.get(chat_id, {}).get("qty", 1.0) if chat_id else 1.0
    cat  = d.get("cat", "")
    sub  = d.get("subcat", "")
    price       = get_tier_price(product_name, qty)
    cart_total  = get_cart_total(chat_id) if chat_id else 0.0
    reviews     = d.get("reviews", 0)

    unit = d.get("unit", "pcs")
    step = d.get("step", 1.0)
    tiers_text = "\n".join(
        f"<code>from {mn:>6.2f} {unit} @ £{pr:.2f}</code>"
        for mn, pr in sorted(d.get("tiers", []))
    )

    path = f"{cat} → {sub}" if sub else cat
    text = (
        f"<b>{product_name}</b>\n"
        f"{path} • Stock {d.get('stock','Unlimited')} • ★ {d.get('rating',0)} ({reviews})\n\n"
        f"{d.get('desc','')}\n\n"
        f"{tiers_text}"
    )

    kb = types.InlineKeyboardMarkup()
    kb.add(types.InlineKeyboardButton("Enter Quantity Manually", callback_data="qty_manual"))
    kb.row(
        types.InlineKeyboardButton(f"▲ +{step:.2f}",      callback_data="qty_plus"),
        types.InlineKeyboardButton(f"🛒 £{cart_total:.2f}", callback_data="cart_view"),
        types.InlineKeyboardButton(f"▼ -{step:.2f}",      callback_data="qty_minus"),
    )
    kb.add(types.InlineKeyboardButton(
        f"Add to Cart : {qty:.2f} {unit} [£{price:.2f}]",
        callback_data="add_to_cart",
        pay=True
    ))
    kb.row(
        types.InlineKeyboardButton("Add to Wishlist", callback_data="add_wishlist"),
        types.InlineKeyboardButton(f"{reviews} reviews for thi...", callback_data="prod_reviews"),
    )
    back_cb = f"subcat_{cat}|{sub}" if sub else f"cat_{cat}"
    kb.add(types.InlineKeyboardButton("Back", callback_data=back_cb))
    return text, kb

